APP_NAME="Sudoku Live"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

CENTRIFUGO_INTERNAL_URL="http://localhost:8081"
CENTRIFUGO_API_KEY="sudokulive-api-key"
CENTRIFUGO_HMAC_SECRET="sudokulive-hmac-secret-change-me-32bytes"
CENTRIFUGO_TOKEN_TTL=3600
CENTRIFUGO_PUBLIC_HOST="localhost"
CENTRIFUGO_PUBLIC_PORT=8081
CENTRIFUGO_PUBLIC_SCHEME="http"
CENTRIFUGO_PUBLIC_WS_URL=
