{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "sudoku-shift",
    "private": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:itch": "node scripts/package-itch.mjs",
        "verify:itch": "node scripts/package-itch.mjs --verify-only",
        "preview": "vite preview",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "eslint src/",
        "dup": "jscpd",
        "quality": "node scripts/quality-score.mjs",
        "cap:sync": "npm run build && cap sync ios",
        "cap:open:ios": "cap open ios",
        "ios:preflight": "cd ios && fastlane preflight",
        "ios:archive": "cd ios && fastlane archive",
        "ios:testflight": "cd ios && fastlane beta",
        "docker:up": "docker compose up -d --build",
        "docker:down": "docker compose down",
        "docker:config": "docker compose config -q && docker compose -f compose.prod.yml config -q",
        "e2e": "playwright test",
        "e2e:headed": "playwright test --headed"
    },
    "dependencies": {
        "@capacitor/core": "^8.3.0",
        "@capacitor/ios": "^8.6.2",
        "centrifuge": "^5.8.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@capacitor/cli": "^8.3.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "jscpd": "^5.4.3",
        "jsdom": "^31.0.1",
        "vite": "^8.0.0",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "minimatch": "^11.0.8"
    }
}
