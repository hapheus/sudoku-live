# Copy to .env (or pass via --env-file .env.prod.example) when deploying or testing against fraha.dev
DOMAIN_NAME=fraha.dev

# Public Web & Centrifugo WebSocket settings
WS_HOST=sudoku-ws.fraha.dev
WS_PORT=443
WS_SCHEME=https
PUBLIC_APP_URL=https://sudoku.fraha.dev

# Allowed WebSocket origins for Centrifugo (includes local Vite/Docker ports for local testing)
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS="https://sudoku.fraha.dev capacitor://localhost https://localhost http://localhost http://localhost:5173 http://localhost:8000"
