# Copy to .env (or pass via --env-file) when deploying with compose.prod.yml + cf-docker-tunnel-sync
DOMAIN_NAME=example.com

# Generate with: php artisan key:generate --show
APP_KEY=base64:replace-with-generated-32-byte-key

# Generate strong random secrets (at least 32 characters for HMAC)
# e.g. openssl rand -hex 32
CENTRIFUGO_API_KEY=replace-with-random-api-key
CENTRIFUGO_HMAC_SECRET=replace-with-random-32-byte-hmac-secret
