{
  "appId": "dev.fraha.sudoku",
  "appName": "Sudoku Shift",
  "webDir": "dist",
  "backgroundColor": "#0f172a",
  "ios": {
    "scheme": "App",
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "scrollEnabled": true,
    "allowsLinkPreview": false
  },
  "server": {
    "hostname": "localhost",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "sudoku.fraha.dev",
      "sudoku-ws.fraha.dev"
    ]
  }
}
