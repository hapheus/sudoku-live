opt_out_usage
default_platform(:ios)

require "xcodeproj"

REPO_ROOT = File.expand_path("../..", __dir__)
PROJECT_PATH = File.expand_path("../App/App.xcodeproj", __dir__)
SCHEME_NAME = "App"
APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "dev.fraha.sudoku")
TEAM_ID = ENV.fetch("APPLE_TEAM_ID", "83EB97U8C3")
BUILD_OUTPUT_DIR = File.expand_path("../App/build", __dir__)

def resolve_asc_api_key
  key_id = ENV["ASC_KEY_ID"].to_s.strip
  issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
  key_filepath = ENV["ASC_KEY_FILEPATH"].to_s.strip
  key_content = ENV["ASC_KEY_CONTENT"].to_s.strip

  return nil if key_id.empty? || issuer_id.empty?
  return nil if key_filepath.empty? && key_content.empty?

  params = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1200,
    in_house: false
  }
  if !key_filepath.empty?
    params[:key_filepath] = File.expand_path(key_filepath, __dir__)
  else
    params[:key_content] = key_content
    params[:is_key_content_base64] = ENV["ASC_KEY_CONTENT_IS_BASE64"] == "true"
  end

  app_store_connect_api_key(**params)
end

def read_current_build_number
  project = Xcodeproj::Project.open(PROJECT_PATH)
  target = project.targets.find { |t| t.name == "App" } || project.targets.first
  raw = target.build_configurations.first.build_settings["CURRENT_PROJECT_VERSION"].to_s
  raw.to_i
end

def write_build_number!(next_build)
  project = Xcodeproj::Project.open(PROJECT_PATH)
  target = project.targets.find { |t| t.name == "App" } || project.targets.first
  target.build_configurations.each do |config|
    config.build_settings["CURRENT_PROJECT_VERSION"] = next_build.to_s
  end
  project.save
  UI.message("Updated CURRENT_PROJECT_VERSION to #{next_build}")
  next_build
end

def build_xcargs(api_key)
  args = ["-allowProvisioningUpdates"]
  key_filepath = ENV["ASC_KEY_FILEPATH"].to_s.strip
  if api_key && !key_filepath.empty?
    resolved_path = File.expand_path(key_filepath, __dir__)
    args << "-authenticationKeyPath \"#{resolved_path}\""
    args << "-authenticationKeyID #{ENV['ASC_KEY_ID'].strip}"
    args << "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID'].strip}"
  end
  args.join(" ")
end

platform :ios do
  desc "Build Vite web bundle and sync Capacitor iOS assets"
  lane :sync_web do
    sh(
      "env",
      "VITE_WS_URL=#{ENV.fetch('VITE_WS_URL', 'wss://sudoku-ws.fraha.dev/connection/websocket')}",
      "npm", "--prefix", REPO_ROOT, "run", "cap:sync"
    )
  end

  desc "Register Bundle ID and create App Store Connect app entry if missing"
  lane :register_app do
    produce(
      app_identifier: APP_IDENTIFIER,
      app_name: ENV.fetch("APP_NAME", "Sudoku Live"),
      language: ENV.fetch("APP_LANGUAGE", "German"),
      app_version: "1.0",
      sku: ENV.fetch("APP_SKU", "dev.fraha.sudoku"),
      team_id: TEAM_ID,
      platforms: ["ios"]
    )
  end

  desc "Build and export a signed App Store IPA locally (without uploading)"
  lane :archive do |options|
    sync_web unless options[:skip_web]
    api_key = resolve_asc_api_key

    build_app(
      project: PROJECT_PATH,
      scheme: SCHEME_NAME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: BUILD_OUTPUT_DIR,
      output_name: "SudokuLive.ipa",
      xcargs: build_xcargs(api_key),
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID,
        uploadSymbols: true
      }
    )
  end

  desc "Build, bump build number, and upload to TestFlight (Internal Testing)"
  lane :beta do |options|
    sync_web unless options[:skip_web]
    api_key = resolve_asc_api_key

    unless options[:skip_bump]
      local_current = read_current_build_number
      remote_latest = 0
      begin
        remote_params = {
          app_identifier: APP_IDENTIFIER,
          initial_build_number: 0
        }
        remote_params[:api_key] = api_key if api_key
        remote_latest = latest_testflight_build_number(**remote_params).to_i
      rescue => ex
        UI.important("Could not fetch remote TestFlight build number (#{ex.message}); using local increment.")
      end

      next_build = [local_current + 1, remote_latest + 1].max
      write_build_number!(next_build)
    end

    build_app(
      project: PROJECT_PATH,
      scheme: SCHEME_NAME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: BUILD_OUTPUT_DIR,
      output_name: "SudokuLive.ipa",
      xcargs: build_xcargs(api_key),
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID,
        uploadSymbols: true
      }
    )

    has_app_specific_password = !ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"].to_s.strip.empty?
    if api_key || has_app_specific_password
      upload_params = {
        app_identifier: APP_IDENTIFIER,
        ipa: File.join(BUILD_OUTPUT_DIR, "SudokuLive.ipa"),
        skip_waiting_for_build_processing: options[:wait] ? false : true,
        changelog: options[:changelog] || "TestFlight Build"
      }
      upload_params[:api_key] = api_key if api_key

      upload_to_testflight(**upload_params)
    else
      require "tempfile"
      archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
      UI.user_error!("Missing XCODEBUILD_ARCHIVE path for Xcode upload") if archive_path.to_s.empty?

      plist = Tempfile.new(["export_upload", ".plist"])
      begin
        plist.write(<<~PLIST)
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>destination</key>
            <string>upload</string>
            <key>method</key>
            <string>app-store-connect</string>
            <key>signingStyle</key>
            <string>automatic</string>
            <key>teamID</key>
            <string>#{TEAM_ID}</string>
            <key>uploadSymbols</key>
            <true/>
          </dict>
          </plist>
        PLIST
        plist.flush

        sh(
          "xcodebuild",
          "-exportArchive",
          "-exportOptionsPlist", plist.path,
          "-archivePath", archive_path,
          "-allowProvisioningUpdates"
        )
      ensure
        plist.close
        plist.unlink
      end
    end
  end
end
