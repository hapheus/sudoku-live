# Fastlane & Capacitor iOS Environment Template
# Copy to ios/fastlane/.env (never commit real credentials or .p8 keys)

# App Identity
APP_IDENTIFIER=dev.fraha.sudoku
APP_NAME="Sudoku Live"
APP_SKU=dev.fraha.sudoku
APP_LANGUAGE=English

# Apple Developer & Signing
APPLE_TEAM_ID=83EB97U8C3
FASTLANE_APPLE_ID=your-apple-id@example.com

# App Store Connect API Key (recommended for CI and passwordless uploads)
# Create a key in App Store Connect -> Users and Access -> Integrations -> App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=./AuthKey_XXXXXXXXXX.p8
# Or base64-encoded key content for CI environments:
# ASC_KEY_CONTENT=
# ASC_KEY_CONTENT_IS_BASE64=true

# Optional: App-specific password fallback when not using ASC API Key
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=

# Capacitor Web Build Endpoints (used by `fastlane ios sync_web`)
VITE_WS_URL=wss://sudoku-ws.fraha.dev/connection/websocket
VITE_PUBLIC_APP_URL=https://sudoku.fraha.dev
